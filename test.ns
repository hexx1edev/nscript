fn main() -> i32 {
    let a = 5;
    let const b: i32 = 15;
    if a > b {
        return 1;
    } else if a < b || a == b && a < 10 {
        return a + b;
    } else {
        a += b;
    }

    return foo(a, b);
}

fn foo(a: bool, b: i32) {
    if a {
        return b;
    } else {
        return b + 10;
    }
}